# ============================================================
# ESP32-S31 语音对话（INMP441 + MAX98357 + DeepSeek ASR/LLM/TTS）
#
# 目标芯片 esp32s31 由 `idf.py --preview set-target esp32s31` 决定，
# 需要 ESP-IDF v6.1.0（S31 是 preview 目标，所有 idf.py 命令必须带 --preview）。
#
# PSRAM 与 CPU/Flash 段取自 xiaozhi-esp32 的 sdkconfig.defaults.esp32s31
# （本工程 PSRAM 用来放录音环形缓冲，8 秒 16bit 单声道 = 256KB）
# ============================================================

# ---------- 控制台：USB Serial/JTAG ----------
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# ---------- 日志 ----------
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ---------- CPU / Flash ----------
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_320=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# ---------- PSRAM（S31 板载 OCT PSRAM）----------
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=102400
CONFIG_SPIRAM_MEMTEST=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# ---------- Wi-Fi（STA 连路由器 + 配网 SoftAP，APSTA 常驻）----------
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=3
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_IRAM_OPT=y

# ---------- HTTPS：内置根证书包（DeepSeek 三个接口都是 https）----------
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=4096
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y

# ---------- lwIP ----------
CONFIG_LWIP_MAX_SOCKETS=8
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16

# ---------- 任务栈：ASR 上传 + JSON 解析都在主任务里，给足 ----------
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# ---------- 分区：默认单 app 1.47MB 装不下 Wi-Fi+TLS+HTTP，改 4MB ----------
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
